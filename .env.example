# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL of your Supabase PostgreSQL instance
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Public client-side anonymous key with Row-Level Security (RLS)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# RESEND_API_KEY: Server-side email delivery API key (https://resend.com)
# When not configured, Maatram Connect automatically runs the consent-guarded In-App Email Simulator & 1-click Gmail dispatch
RESEND_API_KEY="re_123456789"

# RESEND_FROM_EMAIL: Sender email address (must be a verified domain on Resend or onboarding@resend.dev)
RESEND_FROM_EMAIL="Maatram Connect <onboarding@resend.dev>"
